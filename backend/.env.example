# PABMS Configuration Settings

# Database Configuration
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/project_db

# Security & Authentication
# Run `openssl rand -hex 32` to generate a secure secret key
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Application Configuration
PROJECT_NAME="Patient Admission & Bed Management System (PABMS)"
API_V1_STR="/api/v1"